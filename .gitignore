build/
**/.build/
*.ipa
.DS_Store

# generated by xcodegen from project.yml
xcuserdata/
.swiftpm/
.workbuddy

# scratch dir xtool regenerates on every run
**/.xtool-tmp/
# xtool's build output: the .app bundle, its Frameworks and the .ipa.  `*.ipa`
# covers the ipa only, so the assembled .app showed up as untracked after every
# build; the whole directory is generated.
xtool/
# local Rust toolchain + upstream idevice checkout used by
# scripts/build-idevice-ios.sh (keeps ~/.cargo and ~/.rustup untouched)
.rust/

# Pre-patch copies of the vendored archive, written by
# scripts/build-idevice-ios.sh --install and
# scripts/patch-idevice-target-identifier.sh.  They are 70-190 MB each and a
# push carrying one is rejected outright by GitHub's 100 MB limit — which is
# exactly how five commits got stuck on 2026-09-21.  Keep them out of the tree;
# the scripts write them to .backups/ now.
.backups/
Vendor/patches/libidevice_ffi.a.*

# cargo's build directory for the vendored AirliftFFI crate.  815 MB of objects
# and nothing a checkout needs: scripts/build-airlift-ffi-ios.sh rebuilds it.
Vendor/AirliftFFI/rust-core/target/

# The archive scripts/dedupe-airlift-archive.py takes as its input, kept next to
# the de-duplicated copy so the rewrite is repeatable.  A 66 MB duplicate of a
# build output, and the same size class as the .backups/ copies above — the
# linked libairlift_ffi.a is the one the app needs, and --install writes this.
Vendor/AirliftFFI.xcframework/ios-arm64/libairlift_ffi.a.pristine

# Python bytecode.  One .pyc was tracked in scripts/__pycache__/ and every run of
# a check script rewrites them, so they show up as modifications forever.
__pycache__/

# Device logs pulled for diagnosis (pymobiledevice3 apps pull … goldennugget.log).
# They carry the device UDID and whatever the run was doing.
gn*.log

# Release notes are draft prose for the GitHub release, not part of the source.
# Ignoring them keeps a wording edit from showing up as a repo change; covers
# the per-language files (RELEASE_NOTES.md, RELEASE_NOTES.en.md, …).
RELEASE_NOTES*.md


# Dev env shit
.vscode
.zed
tasks.md
