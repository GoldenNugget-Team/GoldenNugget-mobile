+#[cfg(test)]
+mod tunnel_dial_tests {
+    use super::*;
+
+    #[test]
+    fn candidates_preserve_peer_and_drop_duplicates() {
+        let peer = "10.7.0.1".parse().unwrap();
+        let local = "127.0.0.1".parse().unwrap();
+        let mut hosts = vec![peer];
+        for host in [peer, local, local, "0.0.0.0".parse().unwrap(), "224.0.0.1".parse().unwrap()] {
+            add_tunnel_host(&mut hosts, host);
+        }
+        assert_eq!(hosts, vec![peer, local]);
+    }
+
+    #[tokio::test]
+    async fn dial_reports_refusal_and_accepts_open_port() {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let local = listener.local_addr().unwrap();
+        // Reserve a different port, then close it, for an immediate refusal.
+        let closed = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let unavailable = closed.local_addr().unwrap();
+        drop(closed);
+        assert!(dial_tunnel(unavailable).await.is_err());
+        let stream = dial_tunnel(local).await.unwrap();
+        assert_eq!(stream.peer_addr().unwrap(), local);
+    }
+}
