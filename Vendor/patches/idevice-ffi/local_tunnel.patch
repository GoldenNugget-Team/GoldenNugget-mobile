+/// Keep remote connections unchanged on desktop. On iOS the pairing peer can
+/// be the device running the app, reached initially through LocalDevVPN.
+fn tunnel_hosts(peer: std::net::IpAddr) -> Vec<std::net::IpAddr> {
+    #[allow(unused_mut)]
+    let mut hosts = vec![peer];
+    #[cfg(target_os = "ios")]
+    {
+        add_tunnel_host(&mut hosts, std::net::Ipv4Addr::LOCALHOST.into());
+        // getifaddrs owns the sockaddr pointers until freeifaddrs. Only use
+        // active IPv4 Wi-Fi/Ethernet addresses, never cellular or VPN routes.
+        unsafe {
+            let mut head: *mut libc::ifaddrs = std::ptr::null_mut();
+            if libc::getifaddrs(&mut head) == 0 {
+                let mut current = head;
+                while let Some(interface) = current.as_ref() {
+                    if !interface.ifa_addr.is_null() && !interface.ifa_name.is_null()
+                        && interface.ifa_flags & libc::IFF_UP as u32 != 0
+                        && (*interface.ifa_addr).sa_family as i32 == libc::AF_INET
+                        && CStr::from_ptr(interface.ifa_name).to_bytes().starts_with(b"en")
+                    {
+                        let addr = &*(interface.ifa_addr as *const libc::sockaddr_in);
+                        add_tunnel_host(&mut hosts, std::net::Ipv4Addr::from(
+                            addr.sin_addr.s_addr.to_ne_bytes()
+                        ).into());
+                    }
+                    current = interface.ifa_next;
+                }
+                libc::freeifaddrs(head);
+            }
+        }
+    }
+    hosts
+}
+
+#[cfg(any(target_os = "ios", test))]
+fn add_tunnel_host(hosts: &mut Vec<std::net::IpAddr>, host: std::net::IpAddr) {
+    if !hosts.contains(&host) && !host.is_unspecified() && !host.is_multicast() {
+        hosts.push(host);
+    }
+}
