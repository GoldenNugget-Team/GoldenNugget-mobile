+    fn should_store_file(&self, dir: &str, path: &str) -> bool {
+        // NULL means "no filter", i.e. store everything — same as the default.
+        let Some(cb) = self.should_preserve else {
+            return true;
+        };
+        let d = match std::ffi::CString::new(dir) {
+            Ok(c) => c,
+            // A name we cannot hand to C is not a name we can judge; storing it
+            // is the safe answer.
+            Err(_) => return true,
+        };
+        let f = match std::ffi::CString::new(path) {
+            Ok(c) => c,
+            Err(_) => return true,
+        };
+        cb(d.as_ptr(), f.as_ptr(), self.context)
+    }
